# Copy to .env for local development and replace the password hash placeholder.
NODE_ENV=development
APP_ORIGIN=http://app.agent-pages.localhost:3000
CONTENT_BASE_DOMAIN=sites.agent-pages.localhost
DATA_DIR=./.data/development
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=scrypt$131072$8$1$replace-with-32-hex-salt$replace-with-64-hex-hash
PORT=3000

# Optional resource-limit overrides (binary MiB where the name ends in _MB).
# MAX_SITE_SIZE_MB=50
# MAX_FILE_SIZE_MB=20
# MAX_FILES_PER_SITE=500
# MAX_SITES=100
# MAX_TOTAL_SITE_SIZE_MB=1024
# MAX_STORED_SIZE_MB=3072
# REVISION_HISTORY_LIMIT=5
# MIN_FREE_DISK_MB=256
# MAX_BATCH_FILES=100
# MAX_JSON_BODY_MB=2
# MAX_MULTIPART_BODY_MB=25
# MAX_MCP_TEXT_BYTES=65536
# MAX_CONCURRENT_MUTATIONS=2
# MAX_QUEUED_MUTATIONS=16
# MAX_MUTATIONS_PER_MINUTE=30
# MAX_IDEMPOTENCY_RECEIPTS=100000
# MAX_LOGIN_FAILURES_PER_MINUTE=5
# MAX_LOGIN_ATTEMPTS_PER_MINUTE=60
# MAX_CONCURRENT_PASSWORD_VERIFICATIONS=2
